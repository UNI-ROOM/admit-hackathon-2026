# Vencera Echo Game API — native Node development without Docker for the API.
#   docker compose -f compose.test.yml up -d     # PostgreSQL on 127.0.0.1:55432
#   cd server && cp .env.example .env && npm run dev
#   cd echo && npm run dev                       # http://localhost:5173, /api proxied to :3000
# The compose.test.yml database lives in tmpfs: data is wiped when it stops.
# .env is git-ignored: never commit real values.

# Required: the API refuses to start without it.
DATABASE_URL=postgresql://echo_test:echo_test@127.0.0.1:55432/echo_test

# Where the API listens.
HOST=127.0.0.1
PORT=3000

# development | production. production turns on Secure session cookies (HTTPS only).
NODE_ENV=development
# Exact origin the browser opens (the Vite dev server), no trailing slash.
# Requests from any other origin get 403: open http://localhost:5173,
# not http://127.0.0.1:5173, or change this value to match.
PUBLIC_ORIGIN=http://localhost:5173

# Optional sign-in e-mail via Resend. If empty, guests work and
# "Sign in with email" answers "mail unavailable".
# Key: https://resend.com/api-keys ("Sending access"). Keep it secret.
RESEND_API_KEY=
# Sender on a domain verified in Resend; without one use
# "Vencera Echo Game <onboarding@resend.dev>" (delivers only to the account owner).
MAIL_FROM="Vencera Echo Game <echo@vencera.jeanark.dev>"
