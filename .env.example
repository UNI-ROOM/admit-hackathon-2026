# Vencera Echo Game — full stack in Docker Compose (web + API + PostgreSQL).
#   cp .env.example .env && docker compose up --build   →  http://127.0.0.1:8080
# .env is git-ignored: never commit real values.
# On the production server this file lives at /srv/echo/containers/.env
# (read by deploy/release.sh).

# --- Database -----------------------------------------------------------------
# Required. Use a URL-safe random value:  openssl rand -hex 32
# Postgres stores it on first start; changing it later also requires
# ALTER USER inside the database (the pgdata volume keeps the old password).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# --- Web ------------------------------------------------------------------------
# Host port of the site. Bound to 127.0.0.1 only; Caddy proxies to it in production.
WEB_PORT=8080

# --- API ------------------------------------------------------------------------
# development | production. production turns on Secure session cookies (HTTPS only).
NODE_ENV=development
# Exact origin the browser opens, no trailing slash. Requests from any other
# origin get 403, so localhost and 127.0.0.1 are NOT interchangeable.
# Production: https://vencera.jeanark.dev
PUBLIC_ORIGIN=http://127.0.0.1:8080

# --- Sign-in e-mail (Resend) ------------------------------------------------------
# Optional. If empty, the game still works for guests and "Sign in with email"
# answers "mail unavailable". Create a key with "Sending access" at
# https://resend.com/api-keys and keep it secret.
RESEND_API_KEY=
# Sender on a domain verified in Resend. Without a verified domain use
# "Vencera Echo Game <onboarding@resend.dev>": it only delivers to the Resend
# account owner's address.
MAIL_FROM="Vencera Echo Game <echo@vencera.jeanark.dev>"

# IMAGE_TAG is set by CI and deploy/release.sh; leave it unset here.
